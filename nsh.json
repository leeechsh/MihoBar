{
  "name": "MihoBar",
  "id": "dev.mihobar.app",
  "version": "0.2.6",
  "build": 1,
  "icon": "assets/icon/icon.png",
  "rust": ".",
  "root": "App",
  "appearance": "system",
  "window": {
    "title": "MihoBar",
    "defaultSize": {
      "width": 360,
      "height": 560
    },
    "defaultVisible": false,
    "resizable": false,
    "minimizable": false,
    "maximizable": false,
    "closeOnPress": false,
    "frame": "none",
    "level": "floating",
    "workspaces": "all",
    "backdrop": "popover",
    "shadow": true,
    "taskbar": false,
    "movable": false
  },
  "macos": {
    "activationPolicy": "accessory"
  },
  "dataDir": "${homeDir}/Library/Application Support/mihobar",
  "application": {
    "quitMode": "explicit"
  },
  "updater": {
    "github": "leeechsh/MihoBar",
    "publicKey": "JKRFZBfMMfT5c/G1O/A4l8EeEGGmbKSL1+KQOTvm2Y8="
  }
}
